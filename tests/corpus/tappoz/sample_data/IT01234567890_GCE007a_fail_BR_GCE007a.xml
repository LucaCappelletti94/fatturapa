<?xml version="1.0" encoding="UTF-8"?>
<!-- Regola GCE007a: Per operazioni con Natura N2.1, se il destinatario è
     stabilito in un paese UE (diverso da IT), è OBBLIGATORIO indicare la dicitura
     "INVCONT" nel campo <TipoDato> in AltriDatiGestionali.
     Fonte: Guida alla compilazione delle fatture elettroniche e dell'esterometro – Versione 1.10, pag. 34, sezione N2.1.
     URL: https://www.agenziaentrate.gov.it/portale/documents/d/guest/guida_compilazione-fe-esterometro-v1-10_aprile_2025
     NOTA: GCE = Guida Compilazione Esterometro (convenzione interna progetto) -->
<p:FatturaElettronica versione="FPR12" xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">
  <FatturaElettronicaHeader>
    <DatiTrasmissione>
      <IdTrasmittente><IdPaese>IT</IdPaese><IdCodice>01234567890</IdCodice></IdTrasmittente>
      <ProgressivoInvio>00001</ProgressivoInvio>
      <FormatoTrasmissione>FPR12</FormatoTrasmissione>
      <CodiceDestinatario>0000000</CodiceDestinatario>
    </DatiTrasmissione>
    <CedentePrestatore>
      <DatiAnagrafici>
        <IdFiscaleIVA><IdPaese>IT</IdPaese><IdCodice>01234567890</IdCodice></IdFiscaleIVA>
        <Anagrafica><Denominazione>D</Denominazione></Anagrafica>
        <RegimeFiscale>RF01</RegimeFiscale>
      </DatiAnagrafici>
      <Sede><Indirizzo>V</Indirizzo><CAP>00100</CAP><Comune>R</Comune><Nazione>IT</Nazione></Sede>
    </CedentePrestatore>
    <CessionarioCommittente>
      <DatiAnagrafici>
        <!-- Cessionario in FR (paese UE) - scatta requisito GCE007a per INVCONT -->
        <IdFiscaleIVA><IdPaese>FR</IdPaese><IdCodice>12345678901</IdCodice></IdFiscaleIVA>
        <Anagrafica><Denominazione>D</Denominazione></Anagrafica>
      </DatiAnagrafici>
      <Sede><Indirizzo>V</Indirizzo><CAP>75001</CAP><Comune>P</Comune><Nazione>FR</Nazione></Sede>
    </CessionarioCommittente>
  </FatturaElettronicaHeader>
  <FatturaElettronicaBody>
    <DatiGenerali>
      <DatiGeneraliDocumento>
        <TipoDocumento>TD01</TipoDocumento>
        <Divisa>EUR</Divisa>
        <Data>2025-04-01</Data>
        <Numero>123</Numero>
      </DatiGeneraliDocumento>
    </DatiGenerali>
    <DatiBeniServizi>
      <DettaglioLinee>
        <NumeroLinea>1</NumeroLinea>
        <Descrizione>A</Descrizione>
        <PrezzoUnitario>100.00</PrezzoUnitario>
        <PrezzoTotale>100.00</PrezzoTotale>
        <AliquotaIVA>0.00</AliquotaIVA>
        <Natura>N2.1</Natura>
        <!-- VIOLAZIONE GCE007a: Natura=N2.1 con cessionario UE (FR) richiede INVCONT in AltriDatiGestionali -->
      </DettaglioLinee>
      <DatiRiepilogo>
        <AliquotaIVA>0.00</AliquotaIVA>
        <Natura>N2.1</Natura>
        <ImponibileImporto>100.00</ImponibileImporto>
        <Imposta>0.00</Imposta>
      </DatiRiepilogo>
    </DatiBeniServizi>
  </FatturaElettronicaBody>
</p:FatturaElettronica>